# OPTIONAL developer overrides. The app runs with no .env at all: settings are saved
# through the game (PUT /settings) into the database, and API keys into your OS
# keychain. Anything set here wins over those saved values. .env is gitignored.

# 1 = every resident uses the free mock brain (default). 0 = real agents.
MOCK_AGENTS=1

# Every island is a git repository. New island repos are created under this folder.
# Default (works on any computer): ~/Documents/Mii-nagement if you have a Documents
# folder (macOS, Windows), otherwise ~/Mii-nagement (Linux). Each island can also pick
# its own folder, or adopt a repo you already have, when it is created (POST /islands).
# ISLANDS_ROOT=

# Optional: where per-task worktrees of island repos are created (default: backend/.worktrees).
# Agents only ever work inside these worktrees.
# WORKTREE_ROOT=

# Optional: the command the Lab runs in a task's worktree (exit code = pass/fail).
# Without it, the Lab asks the resident to run the tests instead.
# TEST_COMMAND=uv run pytest -q

# Optional: the OpenRouter key for residents on the `openrouter` brain (any model, no CLI).
# Residents pick a model id from https://openrouter.ai/models in their `model` field.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5   # default model for that brain

# Optional API keys. Only needed for ACP brains you don't log in to with a subscription.
# The agent processes inherit them from the environment.
# ANTHROPIC_API_KEY=   # Claude Code
# OPENAI_API_KEY=      # Codex
# GEMINI_API_KEY=      # Gemini CLI

# GitHub uses your logged-in `gh` CLI (gh auth login), so there's no token here.

# Optional: for residents with the `database` gift (an MCP server that queries this database).
# DATABASE_URL=
# Optional: for the `godot` gift: the Godot 4 executable.
# GODOT_PATH=

# Optional: the judge (judge.py) asks TypeSafe's Jev small questions (moods, flaky tests, who
# helps) when a key is set; JUDGE=off keeps the offline rules even then.
# TYPESAFE_API_KEY=
# JUDGE=auto

# Game side (an environment variable for Godot, not the backend): which backend the game
# talks to. Default 127.0.0.1:8000.
# MII_SERVER=127.0.0.1:8001

# Optional pacing (seconds) and knobs.
# WALK_SECONDS=2          # a walk between buildings (lets the game animate)
# BUBBLE_TIMEOUT=30       # how long a resident waits for your answer
# PERMISSION_TIMEOUT=120  # same, for ✋ permission bubbles (default: BUBBLE_TIMEOUT; timeout = reject)
# SLEEP_AFTER=45          # idle this long -> residents fall asleep
# STEP_TIMEOUT=600        # an agent taking longer than this gets stopped
# KEEP_WORKTREES=0        # 1 = keep each task's worktree after it finishes (debugging)
# MASTER_KEY=0            # 1 = residents never ask: every bubble answers itself (a "No" house key still refuses)
# PARALLEL_PACKAGES=3     # packages one island works on at once (1-8; free residents stand in for busy ones)
# GIT_AUTHOR=Mii-nagement <mii@localhost>   # author of the Workshop's commits
# DATABASE_PATH=          # SQLite file (default: backend/mii.db)
