# Copy to .env (repo root) and fill in. .env is gitignored.

# 1 = every resident uses the free mock brain (default). 0 = real agents over ACP.
MOCK_AGENTS=1

# Absolute path to a local git repo the agents may work on. Needed when MOCK_AGENTS=0.
# Agents only ever touch git worktrees of this repo, one per task.
SANDBOX_REPO_PATH=

# Optional: where worktrees are created (default: backend/.worktrees).
# WORKTREE_ROOT=

# Optional API keys. Only needed for agents you don't log in to with a subscription.
# The agent processes inherit them from the environment.
# ANTHROPIC_API_KEY=   # Claude Code
# OPENAI_API_KEY=      # Codex
# GEMINI_API_KEY=      # Gemini CLI

# GitHub uses your logged-in `gh` CLI (gh auth login), so there's no token here.
