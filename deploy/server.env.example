# The server's settings: copy to deploy/server.env (gitignored) and fill in.
# deploy/push.sh refuses to deploy real agents without Auth0 login.

# The site's address. No domain yet? <server ip>.sslip.io works (vultr.sh prints it).
MII_DOMAIN=203.0.113.7.sslip.io

# 0 = real coding agents run on this server. 1 = mock mode (fake work, nothing to protect).
MOCK_AGENTS=0
# Locks settings and server folders against visitors (always keep it on for the web).
PUBLIC_DEMO=1

# Auth0 login (deploy/README.md, "Auth0"): all three, or login is off.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=

# Keys for the brains residents use (only the ones you need).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# gh on the server: cloning islands from GitHub and opening PRs. A fine-grained token
# for just the repos the islands work on.
GH_TOKEN=
