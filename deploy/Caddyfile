# One HTTPS site: the landing page at /, the desktop download at /download/, and the
# backend's API and WebSocket. Caddy gets the certificate from Let's Encrypt by itself.
{$MII_DOMAIN} {
	encode zstd gzip

	@backend path /ws /health /meta /settings /brains /brains/* /gifts /models /islands /islands/* /github/* /replay/* /auth/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle_path /download/* {
		root * /srv/downloads
		file_server
	}

	# The browser build is off for now (deploy/push.sh): the game is a download.
	# redir /app /app/
	# handle_path /app/* {
	# 	root * /srv/game
	# 	file_server
	# }

	handle {
		root * /srv/landing
		file_server
	}
}
