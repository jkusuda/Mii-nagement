[node name="Rows" type="VBoxContainer" parent="Rows/Charts/WaitingPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Rows/Charts/WaitingPanel/Rows"]
layout_mode = 2
theme_type_variation = &"SectionTitle"
theme_override_font_sizes/font_size = 19
