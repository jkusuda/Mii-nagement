[node name="Waiting" type="VBoxContainer" parent="Rows/Charts/WaitingPanel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Spacer" type="Control" parent="Rows/Charts/WaitingPanel/Rows"]
